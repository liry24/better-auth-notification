{
    "name": "better-auth-notification",
    "version": "0.1.1",
    "description": "User notifications, read state, archiving, and delivery hooks for Better Auth",
    "homepage": "https://github.com/liry24/better-auth-notification#readme",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/liry24/better-auth-notification.git",
        "directory": "packages/better-auth-notification"
    },
    "files": [
        "dist"
    ],
    "type": "module",
    "sideEffects": false,
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        },
        "./client": {
            "types": "./dist/client.d.ts",
            "import": "./dist/client.js",
            "default": "./dist/client.js"
        },
        "./package.json": "./package.json"
    },
    "publishConfig": {
        "access": "public",
        "provenance": true
    },
    "scripts": {
        "build": "tsdown",
        "dev": "tsdown --watch",
        "prepack": "bun run build",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "@better-fetch/fetch": "^1.3.2",
        "better-call": "^1.4.0",
        "nanostores": "^1.3.0",
        "zod": "^4.5.4"
    },
    "devDependencies": {
        "@arethetypeswrong/cli": "^0.18.5",
        "@types/node": "^26.6.3",
        "publint": "^0.3.24",
        "tsdown": "^0.23.0",
        "typescript": "^7.0.2"
    },
    "peerDependencies": {
        "@better-auth/core": ">=1.7.7 <1.8.0",
        "better-auth": ">=1.7.7 <1.8.0"
    },
    "engines": {
        "node": ">=24.0.0"
    }
}
