{
    "name": "better-auth-notification-workspace",
    "private": true,
    "workspaces": [
        "packages/*"
    ],
    "type": "module",
    "scripts": {
        "build": "bun --filter better-auth-notification build",
        "check": "bun run format:check && bun run lint && bun run workspace:check && bun run unused && bun run typecheck && bun run build && bun run test",
        "deps:update": "taze",
        "dev": "bun --filter better-auth-notification dev",
        "format": "oxfmt . --write",
        "format:check": "oxfmt . --check",
        "lint": "oxlint .",
        "lint:fix": "oxlint . --fix",
        "preview:package": "pkg-pr-new publish ./packages/better-auth-notification --bun --compact --previewVersion",
        "test": "vitest run",
        "test:unit": "vitest run --project unit",
        "test:integration": "vitest run --project integration",
        "test:client": "vitest run --project client",
        "test:consumer": "vitest run --project consumer",
        "typecheck": "bun --filter better-auth-notification typecheck && tsc --noEmit -p test/tsconfig.json",
        "unused": "knip && knip --production",
        "workspace:check": "sherif"
    },
    "devDependencies": {
        "@types/node": "^26.6.3",
        "@types/react": "^19.2.0",
        "@types/react-dom": "^19.2.0",
        "better-auth": "1.7.7",
        "knip": "^6.38.0",
        "oxfmt": "^0.71.0",
        "oxlint": "^1.86.0",
        "oxlint-tsgolint": "^7.0.2003",
        "pkg-pr-new": "^0.0.88",
        "react": "^19.2.0",
        "react-dom": "^19.2.0",
        "sherif": "^1.13.0",
        "taze": "^21.2.0",
        "typescript": "^7.0.2",
        "vitest": "^5.0.2",
        "vue": "^3.5.43"
    },
    "engines": {
        "node": ">=24.0.0"
    },
    "packageManager": "bun@1.4.2"
}
